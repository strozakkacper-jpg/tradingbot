# Token bota od @BotFather
BOT_TOKEN=123456:ABC...
# (opcjonalne) ID adminów. Puste = adminem zostaje pierwsza osoba, która napisze /start
ADMIN_IDS=
# (opcjonalne) Puste = bot sam wygeneruje klucz i zapisze go w secret.key obok bazy
ENCRYPTION_KEY=
# Domyślna giełda (ceny w trybie demo dla osób bez podłączonej giełdy)
EXCHANGE=binance
# Giełdy do wyboru dla użytkowników i traderów (id z ccxt)
EXCHANGES=binance,bybit,okx,coinbase,kucoin,bitget,gate,mexc
# true = kopiowanie w czasie rzeczywistym przez WebSocket giełdy (≈1 s); false = odpytywanie co POLL_INTERVAL
REALTIME=true
# true = testnet giełdy (jeśli ją ma)
SANDBOX=false
# (opcjonalne) Klucz konta, które przy pierwszym starcie stanie się traderem #1 (wystarczy do odczytu).
# Kolejni traderzy zgłaszają się sami w bocie: /zostan_traderem
LEADER_API_KEY=
LEADER_API_SECRET=
LEADER_API_PASSWORD=
# (opcjonalne) Pary sprawdzane zawsze przy odpytywaniu. Bot i tak sam odkrywa pary z salda tradera.
LEADER_SYMBOLS=
QUOTE=USDT
POLL_INTERVAL=15
PAPER_START=1000
DB_PATH=copybot.db
# Co ile minut zapisywać wartość portfeli (wykresy, stop-loss)
SNAPSHOT_MINUTES=15
# Panel w Telegramie (Mini App) – publiczny adres HTTPS serwera, np. https://1-2-3-4.sslip.io
# install.sh ustawia to automatycznie. Puste = bez panelu.
WEBAPP_URL=
WEB_PORT=8080
# Subskrypcja w Telegram Stars (cena za 30 dni). 0 = bot darmowy
SUB_PRICE_STARS=0
# live = płatne tylko kopiowanie na prawdziwych pieniądzach, all = także demo
SUB_SCOPE=live
# Godzina wieczornego raportu dla kopiujących i strefa czasowa
DAILY_REPORT_HOUR=20
TIMEZONE=Europe/Warsaw
